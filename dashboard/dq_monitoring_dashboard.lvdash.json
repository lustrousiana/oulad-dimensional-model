                      "expression": "`check_name`"
                    },
                    {
                      "name": "check_type",
                      "expression": "`check_type`"
                    },
                    {
                      "name": "fail_count",
                      "expression": "`fail_count`"
                    },
                    {
                      "name": "total_count",
                      "expression": "`total_count`"
                    },
                    {
                      "name": "fail_pct",
                      "expression": "`fail_pct`"
                    },
                    {
                      "name": "owner",
                      "expression": "`owner`"
                    },
                    {
                      "name": "details",
                      "expression": "`details`"
                    }
                  ],
                  "filters": [
                    {
                      "expression": "`status` IN ('FAIL', 'WARN')"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "frame": {
