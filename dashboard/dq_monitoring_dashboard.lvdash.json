{
  "datasets": [
    {
      "name": "dataset1",
      "displayName": "Data Quality Metrics",
      "config": {
        "version": "1.1",
        "source": "`ftw-week-07`.`01-raw`.v_dq_latest",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          },
          {
            "name": "checks_run",
            "expr": "COUNT(*)",
            "displayName": "Checks Run"
          },
          {
            "name": "pass_count",
            "expr": "COUNT_IF(status = 'PASS')",
            "displayName": "Pass Count"
          },
          {
            "name": "warn_count",
            "expr": "COUNT_IF(status = 'WARN')",
            "displayName": "Warn Count"
          },
          {
            "name": "fail_count_total",
            "expr": "COUNT_IF(status = 'FAIL')",
            "displayName": "Fail Count"
          },
          {
            "name": "pass_rate_pct",
            "expr": "(COUNT_IF(status = 'PASS' AND severity <> 'INFO') * 100.0) / NULLIF(COUNT_IF(severity <> 'INFO'), 0)",
            "displayName": "Pass Rate %"
          },
          {
            "name": "total_failures",
            "expr": "SUM(fail_count)",
            "displayName": "Total Failures"
          },
          {
            "name": "latest_check_time",
            "expr": "MAX(executed_at)",
            "displayName": "Latest Check Time"
          }
        ]
      }
    }
  ],
  "pages": [
    {
