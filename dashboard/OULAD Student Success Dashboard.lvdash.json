{
  "datasets": [
    {
      "name": "49a28cb6",
      "displayName": "01-KPI",
      "queryLines": [
        "SELECT ROUND(CORR(total_clicks, avg_score_weighted), 3) AS engagement_score_correlation\r\n",
        "FROM `ftw-week-07`.`04-analytics`.tbl_engagement_performance\r\n",
        "WHERE assessments_submitted > 0;"
      ]
    },
    {
      "name": "bb2ccf94",
      "displayName": "01-Quintile-engagement",
      "queryLines": [
        "WITH base AS (\r\n",
        "    SELECT *\r\n",
        "    FROM `ftw-week-07`.`04-analytics`.tbl_engagement_performance\r\n",
        "    WHERE assessments_submitted > 0\r\n",
        "),\r\n",
        "tiers AS (\r\n",
        "    SELECT *, NTILE(5) OVER (ORDER BY total_clicks) AS engagement_quintile\r\n",
        "    FROM base\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    engagement_quintile,\r\n",
        "    CASE engagement_quintile\r\n",
        "        WHEN 1 THEN '1 — Lowest'\r\n",
        "        WHEN 5 THEN '5 — Highest'\r\n",
        "        ELSE CAST(engagement_quintile AS STRING)\r\n",
        "    END                                AS engagement_tier,\r\n",
        "    COUNT(*)                           AS num_students,\r\n",
        "    ROUND(AVG(total_clicks), 0)        AS avg_clicks_in_tier,\r\n",
        "    ROUND(AVG(avg_score_weighted), 2)  AS avg_weighted_score\r\n",
        "FROM tiers\r\n",
        "GROUP BY engagement_quintile\r\n",
        "ORDER BY engagement_quintile;"
      ]
    },
    {
      "name": "0f826212",
      "displayName": "01-Engagement-outcome",
      "queryLines": [
        "SELECT\r\n",
        "    final_result,\r\n",
        "    COUNT(*)                          AS num_enrollments,\r\n",
        "    ROUND(AVG(total_clicks), 0)       AS avg_total_clicks,\r\n",
        "    ROUND(AVG(active_days), 1)        AS avg_active_days,\r\n",
        "    ROUND(AVG(avg_score_weighted), 2) AS avg_weighted_score\r\n",
        "FROM `ftw-week-07`.`04-analytics`.tbl_engagement_performance\r\n",
        "GROUP BY final_result\r\n",
        "ORDER BY\r\n",
        "    CASE final_result\r\n",
        "        WHEN 'Withdrawn'   THEN 0\r\n",
        "        WHEN 'Fail'        THEN 1\r\n",
        "        WHEN 'Pass'        THEN 2\r\n",
        "        WHEN 'Distinction' THEN 3\r\n",
        "    END;"
      ]
    },
    {
      "name": "89e2bc14",
      "displayName": "Untitled dataset",
      "queryLines": [
        ""
      ]
    },
    {
      "name": "6e1b5ea8",
      "displayName": "04-Assessment-Failures",
      "config": {
        "version": "1.1",
        "source": "-- =====================================================\r\n-- BUSINESS QUESTION:\r\n-- Which assessment types and modules have the highest failure rates?\r\n--\r\n-- Grain:\r\n-- One row per score per assessment\r\n--\r\n-- Sources:\r\n-- dim_assessment\r\n-- fact_assessment\r\n-- =====================================================\r\n\r\nWITH assessment_failure_rates AS (\r\n    SELECT\r\n        da.code_module,\r\n        da.assessment_type,\r\n        fa.score,\r\n        CASE\r\n            -- Scores below 40 are considered failures\r\n            WHEN fa.score < 40 THEN 1\r\n            -- Conditionally include NULLs based on parameter\r\n            WHEN fa.score IS NULL THEN 1\r\n            ELSE 0\r\n        END AS is_failure\r\n\r\n    FROM `ftw-week-07`.`03-mart`.fact_assessment fa\r\n    LEFT JOIN `ftw-week-07`.`03-mart`.dim_assessment da\r\n        ON fa.assessment_key = da.assessment_key\r\n)\r\n\r\nSELECT\r\n    code_module,\r\n    assessment_type,\r\n    COUNT(*) AS total_assessments,\r\n    SUM(CASE WHEN score IS NULL THEN 1 ELSE 0 END) AS null_scores,\r\n    ROUND(SUM(CASE WHEN score IS NULL THEN 1 ELSE 0 END) * 100 / COUNT(*), 2) AS null_pct,\r\n    SUM(is_failure) AS total_failures,\r\n    ROUND(SUM(is_failure) * 100 / COUNT(*), 2) AS failure_rate_pct,\r\n    ROUND(AVG(score), 2) AS average_score\r\nFROM assessment_failure_rates\r\nGROUP BY code_module, assessment_type\r\nORDER BY failure_rate_pct DESC",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
