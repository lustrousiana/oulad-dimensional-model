{
  "datasets": [
    {
      "name": "49a28cb6",
      "displayName": "01-KPI",
      "queryLines": [
        "SELECT ROUND(CORR(total_clicks, avg_score_weighted), 3) AS engagement_score_correlation\r\n",
        "FROM `ftw-week-07`.`04-analytics`.tbl_engagement_performance\r\n",
        "WHERE assessments_submitted > 0;"
      ]
    },
    {
      "name": "bb2ccf94",
      "displayName": "01-Quintile-engagement",
      "queryLines": [
        "WITH base AS (\r\n",
        "    SELECT *\r\n",
        "    FROM `ftw-week-07`.`04-analytics`.tbl_engagement_performance\r\n",
        "    WHERE assessments_submitted > 0\r\n",
        "),\r\n",
        "tiers AS (\r\n",
        "    SELECT *, NTILE(5) OVER (ORDER BY total_clicks) AS engagement_quintile\r\n",
        "    FROM base\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    engagement_quintile,\r\n",
        "    CASE engagement_quintile\r\n",
        "        WHEN 1 THEN '1 — Lowest'\r\n",
        "        WHEN 5 THEN '5 — Highest'\r\n",
        "        ELSE CAST(engagement_quintile AS STRING)\r\n",
        "    END                                AS engagement_tier,\r\n",
        "    COUNT(*)                           AS num_students,\r\n",
        "    ROUND(AVG(total_clicks), 0)        AS avg_clicks_in_tier,\r\n",
        "    ROUND(AVG(avg_score_weighted), 2)  AS avg_weighted_score\r\n",
        "FROM tiers\r\n",
        "GROUP BY engagement_quintile\r\n",
        "ORDER BY engagement_quintile;"
      ]
    },
    {
      "name": "0f826212",
      "displayName": "01-Engagement-outcome",
      "queryLines": [
        "SELECT\r\n",
        "    final_result,\r\n",
        "    COUNT(*)                          AS num_enrollments,\r\n",
        "    ROUND(AVG(total_clicks), 0)       AS avg_total_clicks,\r\n",
        "    ROUND(AVG(active_days), 1)        AS avg_active_days,\r\n",
        "    ROUND(AVG(avg_score_weighted), 2) AS avg_weighted_score\r\n",
        "FROM `ftw-week-07`.`04-analytics`.tbl_engagement_performance\r\n",
        "GROUP BY final_result\r\n",
        "ORDER BY\r\n",
        "    CASE final_result\r\n",
        "        WHEN 'Withdrawn'   THEN 0\r\n",
        "        WHEN 'Fail'        THEN 1\r\n",
        "        WHEN 'Pass'        THEN 2\r\n",
        "        WHEN 'Distinction' THEN 3\r\n",
        "    END;"
      ]
    },
    {
      "name": "2cbb7bee",
      "displayName": "02-withdrawal_by_attribute",
      "queryLines": [
        "WITH base AS (\n",
        "    SELECT\n",
        "        final_result,\n",
        "        date_unregistration,\n",
        "        gender,\n",
        "        region,\n",
        "        highest_education,\n",
        "        age_band,\n",
        "        disability,\n",
        "        COALESCE(CASE WHEN imd_band = '10-20' THEN '10-20%' ELSE imd_band END,\n",
        "                 '(not recorded)')                                 AS imd_band,\n",
        "        CASE WHEN num_of_prev_attempts = 0 THEN '0 - first attempt'\n",
        "             WHEN num_of_prev_attempts = 1 THEN '1 previous'\n",
        "             WHEN num_of_prev_attempts = 2 THEN '2 previous'\n",
        "             ELSE '3 or more' END                                  AS attempts_band,\n",
        "        CASE WHEN studied_credits <=  60 THEN 'a. 30-60 (light)'\n",
        "             WHEN studied_credits <= 120 THEN 'b. 61-120 (standard)'\n",
        "             WHEN studied_credits <= 180 THEN 'c. 121-180 (heavy)'\n",
        "             ELSE 'd. 181+ (very heavy)' END                       AS credits_band\n",
        "    FROM `ftw-week-07`.`03-mart`.dim_student_enrollment\n",
        "),\n",
        "baseline AS (\n",
        "    SELECT AVG(CASE WHEN final_result = 'Withdrawn' THEN 1.0 ELSE 0.0 END) AS rate\n",
        "    FROM base\n",
        "),\n",
        "unpivoted AS (\n",
        "    SELECT 'Gender'            AS attribute, gender            AS value, final_result, date_unregistration FROM base\n",
        "    UNION ALL SELECT 'Age band',             age_band,                   final_result, date_unregistration FROM base\n",
        "    UNION ALL SELECT 'Disability',           disability,                 final_result, date_unregistration FROM base\n",
        "    UNION ALL SELECT 'Prior education',      highest_education,          final_result, date_unregistration FROM base\n",
        "    UNION ALL SELECT 'Deprivation band',     imd_band,                   final_result, date_unregistration FROM base\n",
        "    UNION ALL SELECT 'Region',               region,                     final_result, date_unregistration FROM base\n",
        "    UNION ALL SELECT 'Previous attempts',    attempts_band,              final_result, date_unregistration FROM base\n",
        "    UNION ALL SELECT 'Study load',           credits_band,               final_result, date_unregistration FROM base\n",
        ")\n",
        "SELECT\n",
        "    u.attribute,\n",
        "    u.value,\n",
        "    COUNT(*)                                                            AS enrollments,\n",
        "    SUM(CASE WHEN u.final_result = 'Withdrawn' THEN 1 ELSE 0 END)       AS withdrawn,\n",
        " \n",
        "    -- WHO withdraws\n",
        "    ROUND(100.0 * AVG(CASE WHEN u.final_result = 'Withdrawn'\n",
        "                           THEN 1.0 ELSE 0.0 END), 1)                   AS withdrawal_rate_pct,\n",
        "    ROUND(100.0 * (AVG(CASE WHEN u.final_result = 'Withdrawn'\n",
        "                            THEN 1.0 ELSE 0.0 END) - b.rate), 1)        AS pts_vs_baseline,\n",
        " \n",
        "    -- WHEN they withdraw. The inner CASE returns NULL for non-withdrawals and\n",
        "    -- AVG ignores NULLs, so these are computed over withdrawals only.\n",
        "    ROUND(AVG(CASE WHEN u.final_result = 'Withdrawn'\n",
        "                   THEN u.date_unregistration END), 1)                  AS mean_withdrawal_day,\n",
        "    ROUND(100.0 * AVG(CASE WHEN u.final_result = 'Withdrawn'\n",
        "                           THEN CASE WHEN u.date_unregistration <= 28\n",
        "                                     THEN 1.0 ELSE 0.0 END END), 1)     AS pct_gone_by_week_4\n",
        "FROM unpivoted u\n",
        "CROSS JOIN baseline b\n",
        "GROUP BY u.attribute, u.value, b.rate\n",
        "HAVING COUNT(*) >= 100       -- suppress groups too small to read a rate from\n",
        "ORDER BY u.attribute, withdrawal_rate_pct DESC;"
      ]
    },
    {
      "name": "ffb28492",
      "displayName": "02-withdrawal_by_module",
      "queryLines": [
        "SELECT\n",
        "    code_module,\n",
        "    code_presentation,\n",
        "    code_module || ' ' || code_presentation                        AS module_presentation,\n",
        "    COUNT(*)                                                       AS enrollments,\n",
        "    SUM(CASE WHEN final_result = 'Withdrawn'   THEN 1 ELSE 0 END)  AS withdrawn,\n",
        "    SUM(CASE WHEN final_result = 'Fail'        THEN 1 ELSE 0 END)  AS failed,\n",
        "    SUM(CASE WHEN final_result = 'Pass'        THEN 1 ELSE 0 END)  AS passed,\n",
        "    SUM(CASE WHEN final_result = 'Distinction' THEN 1 ELSE 0 END)  AS distinction,\n",
        "    ROUND(100.0 * AVG(CASE WHEN final_result = 'Withdrawn'\n",
        "                           THEN 1.0 ELSE 0.0 END), 1)              AS withdrawal_rate_pct,\n",
        "    ROUND(AVG(CASE WHEN final_result = 'Withdrawn'\n",
        "                   THEN date_unregistration END), 1)               AS mean_withdrawal_day\n",
        "FROM `ftw-week-07`.`03-mart`.dim_student_enrollment\n",
        "GROUP BY code_module, code_presentation\n",
        "ORDER BY withdrawal_rate_pct DESC;"
      ]
    },
    {
      "name": "2204551c",
      "displayName": "02-withdrawal_timing",
      "queryLines": [
        "SELECT\n",
        "    CASE WHEN date_unregistration IS NULL  THEN 'no date recorded'\n",
        "         WHEN date_unregistration <   0    THEN 'before module start'\n",
        "         WHEN date_unregistration <=  28   THEN 'weeks 1-4'\n",
        "         WHEN date_unregistration <=  84   THEN 'weeks 5-12'\n",
        "         WHEN date_unregistration <= 168   THEN 'weeks 13-24'\n",
        "         ELSE 'week 25+' END                              AS withdrawal_window,\n",
        "    COUNT(*)                                                 AS withdrawals,\n",
        "    ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (), 1)       AS pct_of_withdrawals\n",
        "FROM `ftw-week-07`.`03-mart`.dim_student_enrollment\n",
        "WHERE final_result = 'Withdrawn'\n",
        "GROUP BY 1\n",
        "ORDER BY 1;"
      ]
    },
    {
      "name": "3cab0dc3",
      "displayName": "02-engagement_by_outcome",
      "queryLines": [
        "WITH clicks AS (\n",
        "    SELECT student_enrollment_key, SUM(total_clicks) AS total_clicks\n",
        "    FROM `ftw-week-07`.`03-mart`.fact_activity\n",
        "    GROUP BY student_enrollment_key\n",
        ")\n",
        "SELECT\n",
        "    se.final_result,\n",
        "    COUNT(*)                                                    AS enrollments,\n",
        "    SUM(CASE WHEN c.total_clicks IS NULL THEN 1 ELSE 0 END)     AS never_engaged,\n",
        "    ROUND(100.0 * AVG(CASE WHEN c.total_clicks IS NULL\n",
        "                           THEN 1.0 ELSE 0.0 END), 1)           AS pct_never_engaged,\n",
        "    ROUND(AVG(COALESCE(c.total_clicks, 0)))                     AS mean_clicks,\n",
        "    ROUND(PERCENTILE(COALESCE(c.total_clicks, 0), 0.5))         AS median_clicks\n",
        "FROM `ftw-week-07`.`03-mart`.dim_student_enrollment se\n",
        "LEFT JOIN clicks c ON se.student_enrollment_key = c.student_enrollment_key\n",
        "GROUP BY se.final_result\n",
        "ORDER BY mean_clicks;"
      ]
    }
  ],
